<Window x:Class="chrelyonly_xray_win.Views.AddServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:chrelyonly_xray_win.ViewModels"
        mc:Ignorable="d"
        Title="添加 / 编辑服务器"
        Height="500" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9FAFB">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="添加 / 编辑服务器" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,16"/>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="一键导入分享链接 (vless://, vmess://, trojan://)" FontSize="12" Foreground="#6B7280" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding ShareLink, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="12"/>
                    <Button Grid.Column="1" Content="解析" Command="{Binding ParseLinkCommand}" Margin="8,0,0,0" Padding="12,6" Style="{StaticResource ModernButtonStyle}"/>
                </Grid>

                <Separator Margin="0,4,0,12" Background="#E5E7EB"/>

                <TextBlock Text="服务器名称" FontSize="12" Foreground="#374151" FontWeight="Medium" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="服务器地址 (Host/IP)" FontSize="12" Foreground="#374151" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="端口" FontSize="12" Foreground="#374151" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="协议" FontSize="12" Foreground="#374151" FontWeight="Medium" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" Padding="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="3,0,3,0">
                        <TextBlock Text="安全" FontSize="12" Foreground="#374151" FontWeight="Medium" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Securities}" SelectedItem="{Binding Security}" Padding="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                        <TextBlock Text="传输" FontSize="12" Foreground="#374151" FontWeight="Medium" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Transports}" SelectedItem="{Binding Transport}" Padding="6"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="UUID / 密码" FontSize="12" Foreground="#374151" FontWeight="Medium" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Uuid, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Click="OnCancelClick" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="保存" Click="OnSaveClick" Background="#2563EB" Foreground="#FFFFFF" Style="{StaticResource ModernButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
