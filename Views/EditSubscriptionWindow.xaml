<Window x:Class="chrelyonly_xray_win.Views.EditSubscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="订阅编辑" Height="300" Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Background="#FFFFFF"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock x:Name="TxtHeader" Text="新增 / 编辑订阅源" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,16"/>

            <!-- Form Content -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="订阅备注名称" FontSize="12" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtName" Padding="10,8" FontSize="13" Margin="0,0,0,14"/>

                <TextBlock Text="订阅地址 (URL)" FontSize="12" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUrl" Padding="10,8" FontSize="13"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Click="OnCancelClick"
                        Padding="16,8" FontSize="13" FontWeight="Medium"
                        Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0"/>

                <Button Content="保存订阅" Click="OnSaveClick"
                        Padding="18,8" FontSize="13" FontWeight="Bold"
                        Background="#2563EB" Foreground="#FFFFFF"
                        Style="{StaticResource ModernButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
