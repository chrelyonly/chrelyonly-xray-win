<Window x:Class="chrelyonly_xray_win.Views.EditSubscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="订阅编辑" Height="290" Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="YouYuan, Microsoft YaHei UI, Segoe UI, sans-serif">

    <Border Background="#FFFFFF"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock x:Name="TxtHeader" Text="新增 / 编辑订阅源" FontSize="15" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,12"/>

            <!-- Form Content -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="订阅备注名称" FontSize="11" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName" Padding="8,6" FontSize="12" Margin="0,0,0,10"/>

                <TextBlock Text="订阅地址 (URL)" FontSize="11" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtUrl" Padding="8,6" FontSize="12"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="取消" Click="OnCancelClick"
                        Padding="14,6" FontSize="12" FontWeight="Medium"
                        Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0"/>

                <Button Content="保存订阅" Click="OnSaveClick"
                        Padding="16,6" FontSize="12" FontWeight="Bold"
                        Background="#2563EB" Foreground="#FFFFFF"
                        Style="{StaticResource ModernButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
